---
// Every place for the current feature, grouped by what is recorded. The script re-renders this on change.
import { counts, legend, mapPlaces, placeCell, sourceById, pageText, type Feature } from './load';

interface Props {
  feature: Feature;
}
const { feature } = Astro.props;
const n = counts(feature.id);
const groups = legend(feature)
  .map((l) => ({
    ...l,
    count: n[l.symbol],
    rows: mapPlaces
      .map((p, i) => ({ p, i, c: placeCell(p.id, feature.id) }))
      .filter((r) => (r.c.shown?.symbol ?? 'none') === l.symbol),
  }))
  .filter((g) => g.count > 0);
---

<h2 class="lab sec" id="dm-lh">{feature.name} by place</h2>
<div class="dm-groups" data-list>
  {
    groups.map((g) =>
      g.symbol === 'none' ? (
        <p class="dm-nr">
          Nothing recorded:{' '}
          {g.rows.map((r, k) => (
            <Fragment>
              <span class="nw"><button type="button" class="dm-pn" data-i={r.i}>{r.p.name}</button>{k < g.rows.length - 1 ? ',' : ''}</span>
              {k < g.rows.length - 1 ? ' ' : ''}
            </Fragment>
          ))}
        </p>
      ) : (
        <section class="dm-g">
          <h3 class="dm-gh">
            <span class={`sym ${g.symbol}`} aria-hidden="true" />
            <span>{g.label}</span>
            <span class="tn">· {g.count}</span>
          </h3>
          <ul>
            {g.rows.map((r) => (
              <li>
                <button type="button" class="dm-pl" data-i={r.i}>
                  <span class="t">{r.p.name}, {r.p.region}</span>
                  <span class="m">
                    {sourceById.get(r.c.shown!.source)?.short} {pageText(r.c.shown!.page)}
                    {r.c.differ && <span class="df"> ≠ sources differ</span>}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ),
    )
  }
</div>
