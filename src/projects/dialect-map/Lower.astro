---
// Below the list: recent findings, sources, a glossary and how the map works.
import { countLabel } from '../../lib/format';
import { noneLabel, valueInfo } from './config';
import { featureById, placeById, recent, sourceStats } from './load';
import { yearsText } from './payload';

const newest = recent(10);
// each label once (Present, Partial and Absent are shared by two kinds)
const values = [...new Map(Object.values(valueInfo).map((v) => [v.label, v])).values()];
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---

{
  newest.length > 0 && (
    <Fragment>
      <h2 class="lab sec">Recently added</h2>
      <ol class="dm-recent">
        {newest.map((f) => (
          <li>
            <button type="button" data-place={f.place} data-feature={f.feature}>
              <time datetime={f.added}>{f.added}</time>
              <span>
                {placeById.get(f.place)?.name} · {featureById.get(f.feature)?.name} · {valueInfo[f.value].label.toLowerCase()}
              </span>
            </button>
          </li>
        ))}
      </ol>
    </Fragment>
  )
}

<h2 class="lab sec">Sources</h2>
<ul class="dm-src">
  {
    sourceStats.map((s) => (
      <li>
        <p><b>{s.source.short}</b> <span class="c">{s.source.citation}</span></p>
        <p class="dm-mute">
          Data collected {yearsText(s.source.data)} ·{' '}
          {s.findings === 0 ? 'nothing recorded yet' : `${countLabel(s.findings, 'finding', 'findings')} · ${countLabel(s.features.length, 'feature', 'features')}`}
          {s.source.link && <Fragment> · <a href={s.source.link} target="_blank" rel="noopener">Link ↗</a></Fragment>}
        </p>
      </li>
    ))
  }
</ul>

<h2 class="lab sec">Words</h2>
<dl class="dm-words">
  <dt>Merger</dt>
  <dd>Two sounds that used to be different and now sound the same, like “cot” and “caught”.</dd>
  <dt>Near-merger</dt>
  <dd>Two sounds that are still a tiny bit different when measured, but the people saying them can’t tell.</dd>
  <dt>Vowel shift</dt>
  <dd>A chain of vowels that have all moved to new places in the mouth, so each one now sounds a bit like its neighbour used to.</dd>
  <dt>Said vs heard</dt>
  <dd>Some studies measure how people say words, others test whether they can hear a difference. The two can disagree.</dd>
  {
    values.map((v) => (
      <Fragment>
        <dt>{v.label}</dt>
        <dd>{cap(v.meaning)}</dd>
      </Fragment>
    ))
  }
  <dt>{noneLabel}</dt>
  <dd>No source has been read for this place and sound yet. It does not mean the sound is missing.</dd>
</dl>

<h2 class="lab sec">How it works</h2>
<div class="dm-how">
  <p>Each dot shows what was recorded for that city. When sources disagree, the newest data wins and both are listed in the city’s panel.</p>
  <p>Most data here was collected in the 1990s. Sounds keep changing, so treat it as a snapshot.</p>
  <p>Map outline: US Census Bureau, via us-atlas. City positions are approximate city centres.</p>
</div>
