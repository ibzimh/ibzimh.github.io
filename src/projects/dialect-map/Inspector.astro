---
// The card's inspector, feature view. The script (map.ts) swaps in the city view and re-renders this one.
import { kinds } from './config';
import { counts, differCount, featureSources, legend, places, type Feature } from './load';
import { yearsText } from './payload';

interface Props {
  feature: Feature;
}
const { feature } = Astro.props;
const kind = kinds.find((k) => k.id === feature.kind);
const n = counts(feature.id);
const sources = featureSources(feature.id);
const differs = differCount(feature.id);
---

<div class="card-foot dm-insp" data-inspector>
  <p class="lab">{kind?.label}</p>
  <h2 class="card-title">{feature.name}</h2>
  {feature.also && <p class="dm-also">Also called {feature.also}</p>}
  <p class="dm-say"><span class="lab">Say</span> <i>{feature.examples.join(' · ')}</i></p>
  <p class="card-line">{feature.about}</p>
  {
    sources.length === 0 ? (
      <p class="dm-mute">Nothing recorded for this feature yet.</p>
    ) : (
      <Fragment>
        <ul class="dm-leg">
          {legend(feature.kind).map((l) => (
            <li>
              <button type="button" data-k={`leg:${l.symbol}`} data-sym={l.symbol} aria-pressed="false">
                <span class={`sym ${l.symbol}`} aria-hidden="true" />
                <span class="nm">{l.label}</span>
                <span class="ct tn">{n[l.symbol]}</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="dm-total tn">{places.length} places</p>
        <p class="lab dm-h">Data from</p>
        <ul class="dm-from">
          {sources.map((s) => (
            <li>{s.source.short} · collected {yearsText(s.source.data)} · {s.places} {s.places === 1 ? 'place' : 'places'}</li>
          ))}
        </ul>
        {differs > 0 && <p class="dm-mute">Sources differ in {differs} {differs === 1 ? 'place' : 'places'}. The dot shows the newest data.</p>}
      </Fragment>
    )
  }
  <button type="button" class="dm-copy" data-k="copy">Copy link</button>
</div>
