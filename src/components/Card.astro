---
import { cardAttrs, type CardProps } from '../lib/card';
import Shelf from './Shelf.astro';
import Sketch from './Sketch.astro';
import { numberHtml } from '../lib/format';
import { sketches } from '../lib/sketches';

type Props = CardProps;
const { state, shelves = [], cur, previews = false, links = [], toc = [], nav } = Astro.props;
const chars = [...state.num];
const hasFoot = !!(state.title || state.meta || state.line || links.length || toc.length);
---

<aside class="card" aria-label="Catalogue card" {...cardAttrs(state)}>
  <div class="card-top">
    <div class="card-label">{state.label}</div>
    <div class={`num ${chars.length === 1 ? 'n1' : 'n4'}`} data-l={chars[0]} role="img" aria-label={state.num}>
      {chars.map((ch, i) => (ch === '-' ? <span class="d">-</span> : ch === '1' && i > 0 ? <span class="one">1</span> : ch))}
    </div>
    {shelves.length > 0 && <div class="shelf-wrap">{shelves.map((shelf) => <Shelf shelf={shelf} cur={cur} skipTab={previews} />)}</div>}
  </div>
  <div class="card-bot">
    <div class="sketch-wrap">{state.sketch && <Sketch kind={state.sketch} />}</div>
    {hasFoot && <div class="card-foot">
      {state.title && <h2 class="card-title">{state.title}</h2>}
      <p class="card-meta">{state.meta}</p>
      <p class="card-line">{state.line}</p>
      <div class="card-extra">
        {links.length > 0 && (
          <div class="links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
        )}
        {toc.length > 0 && <div class="lab">Contents</div>}
        {toc.length > 0 && (
          <ol class="toc">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        )}
      </div>
    </div>}
    {
      nav && (nav.prev || nav.next) && (
        <nav class="card-nav" aria-label="Previous and next">
          {nav.prev && (
            <a class="pv" href={nav.prev.href}>
              ← <Fragment set:html={numberHtml(nav.prev.no)} /> {nav.prev.title}
            </a>
          )}
          {nav.next && (
            <a class="nx" href={nav.next.href}>
              <Fragment set:html={numberHtml(nav.next.no)} /> {nav.next.title} →
            </a>
          )}
        </nav>
      )
    }
  </div>
  {/* sketches the script can swap in on list pages */}
  {
    previews && (
      <div hidden data-sketches>
        {Object.keys(sketches).map((kind) => (
          <template data-kind={kind}>
            <Sketch kind={kind} />
          </template>
        ))}
      </div>
    )
  }
</aside>
