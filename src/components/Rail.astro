---
import { collections } from '../catalogue';

interface Props {
  current?: string;
  /** True on the collection page itself; item pages only mark the tab as the current section. */
  onPage?: boolean;
  home?: boolean;
}
const { current, onPage = false, home = false } = Astro.props;
const slotLabel = 'Room for future collections';
---

<nav class="rail" aria-label="Collections">
  <a class="logo" href="/" aria-label="Home" aria-current={home ? 'page' : undefined}>IH</a>
  {
    collections.map((c) => (
      <a class="tab" href={`/${c.slug}/`} aria-current={c.letter === current ? (onPage ? 'page' : 'true') : undefined}>
        <b>{c.letter}</b>
        <small>{c.name}</small>
      </a>
    ))
  }
  <span class="slot" role="img" aria-label={slotLabel} title={slotLabel}>+</span>
  <span class="slot" role="img" aria-label={slotLabel} title={slotLabel}>+</span>
</nav>
