---
import Shell from '../layouts/Shell.astro';
import Collections from '../components/Collections.astro';
import Row from '../components/Row.astro';
import { allShelves, itemStates, monogramState, type CardState } from '../lib/card';
import { getNewestItems } from '../lib/catalogue';

const newest = await getNewestItems(4);
const states = await itemStates(newest);
const state = await monogramState('Ibrahim Hasaan');
const shelves = await allShelves();
---

<Shell
  description="hi, i’m ibrahim hasaan. this website remains unfinished (and may well remain so)"
  layout="list"
  page="home"
  card={{ state, shelves, previews: true }}
>
  <div class="col">
    <h1 class="intro">hi, i’m ibrahim hasaan. this website remains unfinished (and may well remain so)</h1>
    <Collections />
    {
      newest.length > 0 && (
        <Fragment>
          <h2 class="lab sec">Recent</h2>
          <ol class="rows noyr">
            {newest.map((item) => <Row item={item} state={states.get(item.id) as CardState} />)}
          </ol>
        </Fragment>
      )
    }
  </div>
</Shell>
