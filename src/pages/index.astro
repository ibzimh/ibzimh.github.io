---
import { getCounts, getNewestItems, getRange, getTotalCount } from '../lib/catalogue';
import { countLabel } from '../lib/format';

const counts = await getCounts();
const ranges = await Promise.all(counts.map((c) => getRange(c.collection.letter)));
const newest = await getNewestItems(4);
const total = await getTotalCount();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Ibrahim Hasaan</title>
  </head>
  <body>
    <h1>Ibrahim Hasaan</h1>
    <p>{countLabel(total)}</p>
    <ul>
      {
        counts.map((c, i) => (
          <li>
            <a href={`/${c.collection.slug}/`}>{c.collection.name}</a> {c.collection.blurb}{' '}
            {ranges[i] ? `${ranges[i].first} – ${ranges[i].last}` : 'Empty'} · {countLabel(c.count)}
          </li>
        ))
      }
    </ul>
    <h2>Newest</h2>
    <ul>
      {
        newest.map((i) => (
          <li>
            <a href={i.href}>
              {i.no} {i.title}
            </a>{' '}
            {i.dateText}
          </li>
        ))
      }
    </ul>
  </body>
</html>
