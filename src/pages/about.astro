---
import Shell from '../layouts/Shell.astro';
import { collections } from '../catalogue';
import { allShelves, monogramState } from '../lib/card';

const letters = collections.map((c) => `${c.letter} for ${c.name.toLowerCase()}`).join(', ');
const state = await monogramState('About');
const shelves = await allShelves();
---

<Shell
  title="About"
  description="i’m ibrahim hasaan"
  layout="item"
  page="about"
  card={{ state, shelves }}
>
  <div class="col">
    <h1 class="sr">About</h1>
    <div class="about">
      <p>i’m ibrahim hasaan</p>
    </div>
    <section class="elsewhere">
      <h2 class="lab">Elsewhere</h2>
      <ul>
        <li><span>GitHub</span><a href="https://github.com/ibzimh">github.com/ibzimh ↗</a></li>
      </ul>
    </section>
    <section class="how">
      <h2 class="lab">How this catalogue works</h2>
      <p>every item gets a number and the letter in front is the collection it belongs to: {letters}</p>
    </section>
  </div>
</Shell>
