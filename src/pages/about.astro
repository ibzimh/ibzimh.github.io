---
import { collections } from '../catalogue';
import { getCounts, getFirstYear, getTotalCount } from '../lib/catalogue';
import { countLabel } from '../lib/format';

const total = await getTotalCount();
const since = await getFirstYear();
const counts = await getCounts();
const letters = collections.map((c) => `${c.letter} for ${c.name.toLowerCase()}`).join(', ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>About / Ibrahim Hasaan</title>
  </head>
  <body>
    <h1>About</h1>
    <p>
      Catalogue {since ? `since ${since} · ` : ''}{countLabel(collections.length, 'collection', 'collections')} · {countLabel(total)}
    </p>
    <p>Letters: {letters}.</p>
    <ul>
      {counts.map((c) => <li>{c.collection.name}: {countLabel(c.count)}</li>)}
    </ul>
  </body>
</html>
