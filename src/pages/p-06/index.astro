---
import ItemLayout from '../../layouts/ItemLayout.astro';
import Inspector from '../../projects/dialect-map/Inspector.astro';
import Lower from '../../projects/dialect-map/Lower.astro';
import Picker from '../../projects/dialect-map/Picker.astro';
import PlaceList from '../../projects/dialect-map/PlaceList.astro';
import { baseMap } from '../../projects/dialect-map/basemap';
import { buildPayload } from '../../projects/dialect-map/payload';
import { features, places, stats, symbolOf, usingSamples } from '../../projects/dialect-map/load';
// inline, not imported: lib/catalogue.ts globs the pages, so an imported stylesheet would load on every page
import css from '../../projects/dialect-map/map.css?raw';

const first = features[0];
const map = baseMap('us');
const payload = buildPayload(first.id);
const statsText = [
  `${places.length} places`,
  `${features.length} features`,
  stats.lastAdded ? `${stats.sources} ${stats.sources === 1 ? 'source' : 'sources'}` : '',
  stats.lastAdded ? `last added ${stats.lastAdded}` : 'nothing recorded yet',
]
  .filter(Boolean)
  .join(' · ');
---

<ItemLayout no="P-06">
  <style is:inline set:html={css}></style>
  <Inspector slot="card" feature={first} />
  <div class="dm" data-dm>
    <header class="head">
      <div class="ttl" aria-hidden="true">Dialect map</div>
      <p>Pick a sound to see which cities have it. Click a city to see everything recorded there, and where it came from.</p>
      <p class="dm-stats tn">{statsText}</p>
    </header>
    <Picker first={first} />
    <figure class="dm-map">
      <div class="dm-frame" tabindex="-1" role="img" aria-label={`Map of the United States with a dot for each of ${places.length} cities`}>
        <svg viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true" focusable="false">
          <path class="land" d={map.land}></path>
          <path class="bord" d={map.borders}></path>
        </svg>
        <div class="dm-dots" aria-hidden="true">
          {places.map((p, i) => <span class={`sym dot ${symbolOf(p.id, first.id)}`} data-i={i} style={`left:${p.x}%;top:${p.y}%`} />)}
        </div>
      </div>
      <figcaption class="dm-cap">
        Each dot is one city. Grey means nothing recorded yet, not ‘no’.
        <span class="dm-tip" hidden>Tip: <kbd>[</kbd> and <kbd>]</kbd> step through features.</span>
      </figcaption>
      <noscript><p class="dm-cap">Turn on JavaScript to switch features and pick cities.</p></noscript>
    </figure>
    {
      usingSamples && (
        <p class="dm-sample">
          <b>Sample data.</b> These findings are made up to show how the map works. They disappear once findings.csv has a real row, and never reach the live site.
        </p>
      )
    }
    <div class="dm-slot" data-inspector-slot></div>
    <script is:inline data-astro-rerun>
      (function () {
        var i = document.querySelector('[data-inspector]');
        var s = document.querySelector('[data-inspector-slot]');
        if (i && s && matchMedia('(max-width:999px)').matches) s.appendChild(i);
      })();
    </script>
    <PlaceList feature={first} />
    <Lower />
    <div class="sr" aria-live="polite" data-live></div>
    <script type="application/json" id="dm-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  </div>
</ItemLayout>

<script>
  import '../../projects/dialect-map/map';
</script>
