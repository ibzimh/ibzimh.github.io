---
import type { GetStaticPaths } from 'astro';
import { collections } from '../catalogue';
import Shell from '../layouts/Shell.astro';
import ItemLayout from '../layouts/ItemLayout.astro';
import Filters from '../components/Filters.astro';
import Row from '../components/Row.astro';
import { getShelves, itemStates, type CardState } from '../lib/card';
import { collectionBySlug, getAllItems, getCollectionItems, getItemByNumber, renderItem } from '../lib/catalogue';
import { countLabel, kindSlug } from '../lib/format';

type Props = { type: 'collection'; slug: string } | { type: 'item'; no: string };

// One route file for collection pages and item pages; custom items have their own pages.
export const getStaticPaths = (async () => {
  const items = (await getAllItems()).filter((i) => !i.custom);
  return [
    ...collections.map((c) => ({ params: { slug: c.slug }, props: { type: 'collection', slug: c.slug } as Props })),
    ...items.map((i) => ({ params: { slug: i.id }, props: { type: 'item', no: i.no } as Props })),
  ];
}) satisfies GetStaticPaths;

const props = Astro.props as Props;
const collection = props.type === 'collection' ? collectionBySlug(props.slug) : undefined;
const list = collection ? await getCollectionItems(collection.letter) : [];
const states = await itemStates(list);
const first = list[0];
const project = collection?.show === 'project';
const countText = collection ? `${collection.name} · ${countLabel(list.length)}` : '';
const state: CardState = collection
  ? first
    ? { ...(states.get(first.id) as CardState), label: countText }
    : { num: collection.letter, label: countText, title: '', meta: '', line: '', sketch: '' }
  : { num: '', label: '', title: '', meta: '', line: '', sketch: '' };
const shelves = collection ? await getShelves([collection.letter]) : [];
const kinds = collection ? collection.kinds.map((kind) => ({ kind, count: list.filter((i) => i.kind === kind).length })) : [];
const item = props.type === 'item' ? await getItemByNumber(props.no) : undefined;
const rendered = item ? await renderItem(item) : undefined;
const Content = rendered?.Content;
let lastYear = '';
---

{
  collection && (
    <Shell
      title={collection.name}
      description={collection.blurb}
      layout="list"
      page="collection"
      coll={collection.letter}
      card={{ state, shelves, cur: first?.no, previews: true }}
    >
      <div class="col">
        <header class="head">
          <h1>{collection.name}</h1>
          <p>{collection.intro}</p>
        </header>
        <Filters name={collection.name} kinds={kinds} total={list.length} />
        {list.length === 0 ? (
          <p class="none">Nothing here yet.</p>
        ) : (
          <ol class={`rows${project ? ' noyr' : ''}`}>
            {list.map((i) => {
              const year = project ? undefined : i.year !== lastYear ? i.year : '';
              lastYear = i.year;
              return <Row item={i} state={states.get(i.id) as CardState} year={year} kindToken={kindSlug(i.kind)} />;
            })}
          </ol>
        )}
      </div>
    </Shell>
  )
}
{
  item && Content && (
    <ItemLayout no={item.no} headings={rendered?.headings}>
      <article class="article">
        <Content />
      </article>
    </ItemLayout>
  )
}
